class Solution {
    public String reverseWords(String s) {
        char[] ar=s.toCharArray();
        int j=ar.length-1;
        StringBuilder sb=new StringBuilder(ar.length);
        while(j>=0)
        {
            while(j>=0&&ar[j]==' ')
            {
                j--;
            }
            if(j<0)
            {
                break;
            }
            int i=j;
            while(i>=0&&ar[i]!=' ')
            {
                i--;

            }

           
            if(sb.length()>0)
            {
                sb.append(' ');
            }
            sb.append(s,i+1,j+1);
            j=i-1;

        }
        return sb.toString();

        
    }
}
